{
  "permissions": {
    "deny": [
      "Edit(/knowledge/standards/**)",
      "Edit(/knowledge/roster/**)",
      "Edit(/registry/**)",
      "Edit(**/metrics.jsonl)",
      "Edit(**/transitions.jsonl)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/tools/hooks/registry-hook.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
